{
  "name": "cargo-find-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "snapshot": "bun scripts/snapshot.ts",
    "embed": "python3 scripts/embed.py",
    "build:index": "bun run snapshot && bun run embed",
    "bench": "bun bench/run.ts",
    "test": "bun test",
    "check": "biome check . && tsc -p packages/core --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.4",
    "typescript": "5.9.3"
  }
}
